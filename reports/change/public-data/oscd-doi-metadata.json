{"data":{"id":"10.21227/asqe-7s69","type":"dois","attributes":{"doi":"10.21227/asqe-7s69","prefix":"10.21227","suffix":"asqe-7s69","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"Caye Daudt, Rodrigo","nameType":"Personal","givenName":"Rodrigo","familyName":"Caye Daudt","affiliation":["ONERA"],"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-4952-9736","nameIdentifierScheme":"ORCID"}]},{"name":"Le Saux, Bertrand","nameType":"Personal","givenName":"Bertrand","familyName":"Le Saux","affiliation":["ONERA"],"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0001-7162-6746","nameIdentifierScheme":"ORCID"}]},{"name":"Boulch, Alexandre","nameType":"Personal","givenName":"Alexandre","familyName":"Boulch","affiliation":["ONERA"],"nameIdentifiers":[{"schemeUri":"https://orcid.org","nameIdentifier":"https://orcid.org/0000-0002-4196-9665","nameIdentifierScheme":"ORCID"}]},{"name":"Gousseau, Yann","nameType":"Personal","givenName":"Yann","familyName":"Gousseau","affiliation":["Telecom ParisTech"],"nameIdentifiers":[]}],"titles":[{"title":"OSCD - Onera Satellite Change Detection"}],"publisher":"IEEE DataPort","container":{},"publicationYear":2019,"subjects":[{"subject":"Computer Vision"},{"subject":"Image Processing"},{"subject":"Geoscience and Remote Sensing"},{"subject":"Change detection"},{"subject":"Satellite Images"},{"subject":"Sentinel"},{"subject":"remote sensing"}],"contributors":[],"dates":[{"date":"2019-10-09","dateType":"Issued"}],"language":null,"types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Open Access Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution","rightsUri":"https://creativecommons.org/licenses/by/4.0"}],"descriptions":[{"description":"The DatasetThe Onera Satellite Change Detection dataset addresses the issue of detecting changes between satellite images from different dates.It comprises 24 pairs of multispectral images taken from the Sentinel-2 satellites between 2015 and 2018. Locations are picked all over the world, in Brazil, USA, Europe, Middle-East and Asia. For each location, registered pairs of 13-band multispectral satellite images obtained by the Sentinel-2 satellites are provided. Images vary in spatial resolution between 10m, 20m and 60m.Pixel-level change ground truth is provided for 14 of the image pairs. The annotated changes focus on urban changes, such as new buildings or new roads. These data can be used for training and setting parameters of change detection algorithms. The BenchmarkThe algorithms can be tested in a benchmark for change detection.The ground truth for the 10 remaining images remain undisclosed. Change prediction maps can be uploaded for evaluation on the IEEE GRSS DASE website. Various metrics such as per-class accuracy and confusion matrices are automatically computed on the website, and are available for participants. Comparison to the best performing methods is provided in the leaderboard associated with this benchmark.ReferencesIf you use this work for your projects, please take the time to cite our paper:Urban Change Detection for Multispectral Earth Observation Using Convolutional Neural Networks, R. Caye Daudt, B. Le Saux, A. Boulch, Y. Gousseau. IEEE International Geoscience and Remote Sensing Symposium (IGARSS’2018). Valencia, Spain. July 2018.[PDF] [BibTeX] The TeamRodrigo Caye Daudt, rodrigo.daudt@onera.frBertrand Le Saux, bertrand.le_saux@onera.frAlexandre Boulch, alexandre.boulch@onera.frYann Gousseau, yann.gousseau@telecom-paristech.fr","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://ieee-dataport.org/open-access/oscd-onera-satellite-change-detection","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"ez","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":1,"citationsOverTime":[{"year":"2023","total":1}],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2019-10-09T12:19:34.000Z","registered":"2019-10-09T12:19:34.000Z","published":"2019","updated":"2023-06-05T08:55:43.000Z"},"relationships":{"client":{"data":{"id":"ieee.dataport","type":"clients"}},"provider":{"data":{"id":"ieee","type":"providers"}},"media":{"data":{"id":"10.21227/asqe-7s69","type":"media"}},"references":{"data":[]},"citations":{"data":[{"id":"10.1080/2150704x.2023.2217527","type":"dois"}]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}